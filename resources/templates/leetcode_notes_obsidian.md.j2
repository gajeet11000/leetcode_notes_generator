{# Personal study-notes template with Obsidian features (wikilinks).
   Data vars (from the sync pipeline): frontend_id, slug, title, difficulty, url
   Tag var: tags — personal pattern tags + LeetCode question-tag slugs, combined
   Linking vars: problem_link — vault-relative wikilink target (no extension)
     for the rendered problem/solution file
   Prefill vars (all optional — pass None/empty to leave blank for manual fill):
     aliases, related, problem_summary, core_idea, trap,
     recognition_clue, complexity_time, complexity_space
   Loop invariant vars: invariant_statement (single sentence), plus
     invariant_initialization/invariant_maintenance/invariant_termination
     (each up to 5 short bullets) — see the "invariant_*" FIELD GUIDANCE
     blocks in resources/prompts/ai_prefill/system_prompt.txt
   (the algorithmic pattern lives in frontmatter tags above, not as its own
   body section — see _tags in markdown_notes.py)
   takeaway is deliberately NOT a prefill var — always rendered blank, even
   with --ai, since it's meant to be the user's own words (see
   LeetCodeDSAProblemNotesRender.render)
   flashcards: list[str], deterministic deck-tag scaffold for the Obsidian
     Spaced Repetition plugin — NOT part of AI prefill (see
     modules/render/markdown_notes.py::_flashcard_deck_tags): one
     "#flashcards/DSA/<tag>" line per note tag, plus
     "#flashcards/DSA/problems/<slug>", no cards. Cards are added by hand. #}
{% macro bullets(items) -%}
    {%- if items -%}
        {{ "- " ~ items | join("\n- ") }}
    {%- else -%}
        -
    {%- endif -%}
{% endmacro -%}
---
id: {{ frontend_id }}
slug: {{ slug }}
aliases: [{% for a in aliases %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
tags:
{% for t in tags %}
 - {{ t }}
{% endfor %}
difficulty: {{ difficulty }}
platform: LeetCode
problem_link: "{{ url }}"
{% if related %}
  related:
  {% for r in related %}
        - "[[{{ r }}]]"
  {% endfor %}
{% endif %}

---

# {{ frontend_id }}. {{ title }}
### 🔗 **Problem & Solution:** [[{{ problem_link }}|Link]]



**Problem:**
> {{ problem_summary or '' }}

**Recognition clue:**
{{ bullets(recognition_clue) }}

**Core idea:**
{{ bullets(core_idea) }}

**Loop Invariant:**
*Statement:* {{ invariant_statement or '' }}

*Initialization:*
{{ bullets(invariant_initialization) }}

*Maintenance:*
{{ bullets(invariant_maintenance) }}

*Termination:*
{{ bullets(invariant_termination) }}

**Trap:**
{{ bullets(trap) }}

**Complexity:**
- Time: `{{ complexity_time or 'O(?)' }}`
- Space: `{{ complexity_space or 'O(?)' }}`

**My takeaway:**
{{ bullets(takeaway) }}
{% if related %}

                            ---
    **Related:**
    {% for r in related %}
        - [[{{ r }}]]
    {% endfor %}
{% endif %}
{% if flashcards %}

> [!info]- Flashcards
{% for line in flashcards %}
> {{ line }}
{% endfor %}
{% endif %}
